# .aws_helpers
# Helper functions for switching between AWS profiles
# awsall: List all available profles
# awsp: switch to a profile (e.g. awsp foobar)
# awswho: show currently configured profile information

alias awsall="_awsListAll"
alias awsp="_awsSwitchProfile"
alias awswho="aws configure list"

function _awsListAll() {

    credentialFileLocation=${AWS_SHARED_CREDENTIALS_FILE};
    if [ -z $credentialFileLocation ]; then
        credentialFileLocation=~/.aws/credentials
    fi

    while read line; do
      if [[ $line == "["* ]]; then echo "$line" | sed 's/\[\(.*\)\]/\1/g'; fi;
    done < $credentialFileLocation;
}

function _awsSwitchProfile() {
    selected_profile=$1;
    if [ -z $selected_profile ]; then  
        selected_profile=$(_awsListAll | fzf --prompt="Select AWS Profile: " --height=40% --border --preview="aws configure list --profile {}");
        if [ -z $selected_profile ]; then
            echo "No profile selected. Aborting."
        fi
    fi

    exists="$(aws configure get aws_access_key_id --profile $selected_profile 2>/dev/null)"
    if [[ -n $exists ]]; then
        export AWS_DEFAULT_PROFILE=$selected_profile;
        export AWS_PROFILE=$selected_profile;
        export AWS_REGION=$(aws configure get region --profile $selected_profile);
        echo "Switched to AWS Profile: $selected_profile";
        aws configure list
    fi
}
